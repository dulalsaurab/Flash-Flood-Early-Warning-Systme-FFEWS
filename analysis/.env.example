# Copy this file to .env (which is gitignored) and fill in your own credentials.
# None of these services require payment -- all are free registrations.

# OpenTopography (DEM download) -- https://opentopography.org/ -> myOpenTopo -> Request API key
OPENTOPOGRAPHY_API_KEY=

# NASA Earthdata (GPM IMERG rainfall via the `earthaccess` package) -- https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# GloFAS discharge reanalysis (only needed if no real gauge record is found) now lives on a
# SEPARATE Copernicus portal from the main Climate Data Store: the CEMS Early Warning Data Store
# (EWDS) -- https://ewds.climate.copernicus.eu/ -> log in (same Copernicus/ECMWF account works) ->
# https://ewds.climate.copernicus.eu/how-to-api for your key. You must also open the
# "CEMS-GloFAS historical" dataset page on ewds.climate.copernicus.eu itself and accept its
# license terms once, or API calls will be rejected even with a valid key.
CDS_URL=https://ewds.climate.copernicus.eu/api
CDS_KEY=
