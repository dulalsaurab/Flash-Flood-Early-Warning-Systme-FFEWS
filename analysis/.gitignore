# Credentials -- never commit. Copy .env.example to .env and fill in locally.
.env

# Python environments and caches
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# Raw downloads: large (hundreds of MB) and fully regenerable by scripts
# 01/02/03/07/09 from the public APIs documented in README.md.
data/raw/*
!data/raw/.gitkeep

# Large intermediate rasters (regenerable by script 05) and scratch encodings.
outputs/*.tif
outputs/*.b64

# Derived results (small CSVs and the figures used in the paper) ARE tracked,
# so every number and figure in the paper can be verified without registering
# for API credentials or re-downloading the source datasets.
